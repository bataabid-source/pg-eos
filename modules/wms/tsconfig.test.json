{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
    // Fix round 1 (F20): receive-inbound.test.ts now imports packages/contracts/wms/receive-inbound
    // through its package subpath export (@pg-eos/contracts/wms/receive-inbound —
    // packages/contracts/package.json's own `exports` map), not a deep relative path — the rootDir
    // widening this project previously needed for that deep import is gone; tsconfig.json's default
    // (repo-relative to modules/wms) governs again.
  },
  "include": [
    "index.ts",
    "*.ts",
    "tests/integration/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/receive-inbound/**/*.ts",
    "tests/count-inventory/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
