{
  "name": "@pg-eos/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wms/receive-inbound": {
      "types": "./dist/wms/receive-inbound.d.ts",
      "default": "./dist/wms/receive-inbound.js"
    },
    "./platform/evaluate-alerts": {
      "types": "./dist/platform/evaluate-alerts.d.ts",
      "default": "./dist/platform/evaluate-alerts.js"
    },
    "./hr/register-employee": {
      "types": "./dist/hr/register-employee.d.ts",
      "default": "./dist/hr/register-employee.js"
    },
    "./catalog/maintain-price-list": {
      "types": "./dist/catalog/maintain-price-list.d.ts",
      "default": "./dist/catalog/maintain-price-list.js"
    },
    "./platform/maintain-site": {
      "types": "./dist/platform/maintain-site.d.ts",
      "default": "./dist/platform/maintain-site.js"
    },
    "./imile/report-agent-health": {
      "types": "./dist/imile/report-agent-health.d.ts",
      "default": "./dist/imile/report-agent-health.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "generate:openapi": "tsc -p tsconfig.json && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.10.0",
    "@types/node": "^24.13.6",
    "fast-check": "^4.10.2",
    "typescript": ">=5.7.0 <6.1.0",
    "vitest": "^4.1.11"
  }
}
