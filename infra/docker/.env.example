# PG-EOS · local development — copy to infra/docker/.env (git-ignored) only to override a default.
# Local values only; Tier 0 secrets live on the host (docs/package/42-Oracle-Cloud-Deployment.md §4.3).

# pgAdmin (`--profile tools` only, bound to 127.0.0.1:5050). Default when unset: pgadmin-dev (D-108).
PGADMIN_PASSWORD=pgadmin-dev

# Connection used by apply.sh, guards and the integration tests (turbo globalEnv, D-107).
PGHOST=localhost
PGPORT=5432
# PGDATABASE — one Postgres database per worktree, all in the SAME local container (P4a,
# GM 2026-09-26): the Master checkout (pg-eos-gov / claude-kit) uses `pgeos`; each lane worktree
# (../pg-eos-lane-1/2/3) uses its own `pgeos_lane<id>` so lane test fixtures stop colliding.
# A lane sets this by running `bash scripts/lane-db.sh <id>` (it creates the database, applies
# the schema and rewrites this key here) — never by hand-editing this file.
PGDATABASE=pgeos
PGUSER=postgres
