{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["PGHOST", "PGPORT", "PGDATABASE", "PGUSER", "PGPASSWORD"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:isolation": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {}
  }
}
