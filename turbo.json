{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["PGHOST", "PGPORT", "PGDATABASE", "PGUSER", "PGPASSWORD", "PG_APP_USER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@pg-eos/db#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@pg-eos/platform#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@pg-eos/wms#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@pg-eos/sales#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:isolation": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:ops": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {}
  }
}
