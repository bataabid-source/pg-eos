#!/usr/bin/env bash
# PG-EOS · commit-msg hook — CLAUDE.md · GIT (GM directive 2026-09-23, B4).
# Refuses any commit whose first line is not `type(WBS): description`, where WBS is an ID present
# in docs/package/38-WBS.md (e.g. 2.8, X.3) or the literal `X` (cross-cutting / governance work).
# Activated by `git config core.hooksPath .githooks` (scripts/install-hooks.mjs, root `prepare`).
set -euo pipefail

msg_file="$1"
first="$(sed -n '1p' "$msg_file")"
types='feat|fix|docs|chore|test|refactor|perf|build|ci|style|revert|wip'

if [[ ! "$first" =~ ^(${types})\(([0-7]\.[0-9]+[ab]?|X(\.[0-9]+)?)\):\ .+$ ]]; then
  {
    echo "commit-msg: REFUSED — first line must be 'type(WBS): description'"
    echo "  types : ${types//|/ }"
    echo "  WBS   : an ID from docs/package/38-WBS.md (0.1 … 7.12 incl. 0.6a/0.6b, X.1 … X.6) or X"
    echo "  got   : ${first}"
  } >&2
  exit 1
fi

wbs="${BASH_REMATCH[2]}"
type="${BASH_REMATCH[1]}"

# D-179 (2026-09-25) — CLAUDE.md · SESSION OPERATING DIRECTIVE: "A `docs(X)` commit happens only
# on a GM directive quoted verbatim." The body must carry the directive or the decision it records.
if [[ "$type" == "docs" && "$wbs" == "X" ]]; then
  if ! grep -qE '^(GM-Directive: ".{8,}"|Decision: D-[0-9]{3,})' "$msg_file"; then
    {
      echo "commit-msg: REFUSED — a docs(X) commit needs a body trailer line, one of:"
      echo "  GM-Directive: \"<the GM's words, verbatim>\""
      echo "  Decision: D-NNN            (the DECISION_LOG row this commit records)"
      echo "  (CLAUDE.md · SESSION OPERATING DIRECTIVE · BUILD, DON'T GOVERN)"
    } >&2
    exit 1
  fi
fi

# P7 (2026-09-26): a feat/fix commit on a WBS row carries a `Review:` trailer in one of the two forms
# parsed by scripts/lib/review-trailer.sh — old `PASS(<n> findings fixed)` or new `PASS(<n> findings,
# <r> rounds)`. wip/chore/docs/build/… and `X` commits are not checked here.
if [[ ( "$type" == "feat" || "$type" == "fix" ) && "$wbs" != "X" ]]; then
  lib="$(git rev-parse --show-toplevel)/scripts/lib/review-trailer.sh"
  if [[ -f "$lib" ]]; then
    # shellcheck source=/dev/null
    . "$lib"
    rline="$(review_trailer_line "$msg_file")"
    if [[ -z "$(review_trailer_form "$rline")" ]]; then
      {
        echo "commit-msg: REFUSED — a ${type}(${wbs}) commit needs a Review trailer:"
        echo "  Review: PASS(<n> findings, <r> rounds)     (P7 form; free text may follow)"
        echo "  Review: PASS(<n> findings fixed)          (pre-P7 form, still accepted)"
        echo "  got: ${rline:-<none>}"
      } >&2
      exit 1
    fi
  fi
fi

if [[ "$wbs" != "X" ]]; then
  root="$(git rev-parse --show-toplevel)"
  wbs_doc="${root}/docs/package/38-WBS.md"
  if [[ ! -f "$wbs_doc" ]]; then
    echo "commit-msg: REFUSED — ${wbs_doc} not found; cannot validate WBS ${wbs}" >&2
    exit 1
  fi
  if ! grep -qE "^\| ${wbs//./\.} \|" "$wbs_doc"; then
    echo "commit-msg: REFUSED — WBS ${wbs} is not a row of docs/package/38-WBS.md" >&2
    exit 1
  fi
fi
exit 0
