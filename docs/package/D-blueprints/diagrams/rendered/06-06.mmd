  po[أمر شراء PO — يحجز committed_amount]
  rcv[استلام وفحص]
  match{{"مطابقة ثلاثية — أمر واستلام وفاتورة"}}
  freeze["تجميد الدفع — three_way_matched = false"]
  pay["اعتماد الدفع — القيد no_pay_before_match يسمح"]
